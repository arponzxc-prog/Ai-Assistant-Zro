<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_jarvis_row_item"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvLogSender"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="John Doe"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLogTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12:45 PM"
            android:textColor="?attr/themeTextMuted"
            android:textSize="11sp"
            android:fontFamily="sans-serif"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvLogStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REPLIED"
            android:textColor="@color/status_green"
            android:background="@drawable/bg_jarvis_status_badge_green"
            android:textSize="9sp"
            android:textStyle="bold"
            android:paddingHorizontal="7dp"
            android:paddingVertical="3dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvLogIncoming"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Incoming: Where are you right now?"
        android:textColor="?attr/themeTextMuted"
        android:textSize="12sp"
        android:fontFamily="sans-serif"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/tvLogReply"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reply: I am currently busy, will get back shortly."
        android:textColor="?attr/themeAccent"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="2dp" />
</LinearLayout>
